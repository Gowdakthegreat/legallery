# Rede em que o agente trabalha. Use o mesmo nome do `yarn deploy --network <nome>`,
# porque é ele que define o diretório de deployments lido pelo agente.
#   default  -> chain local do Hardhat
#   sepolia  -> testnet pública
NETWORK=default

# RPC. Em branco usa o padrão da rede (localhost:8545 ou Alchemy Sepolia).
RPC_URL=
ALCHEMY_API_KEY=

# Chave do agente jurídico. Padrão: conta #2 do Hardhat (a mesma gravada no deploy local).
# Em rede pública, gere uma com `yarn contas` e deixe saldo nela: são 2 transações por obra.
AGENT_PRIVATE_KEY=

# Quanto tempo a instrução do processo deve durar, em milissegundos.
# A espera é sempre pelo tempo que falta: se as transações já levaram mais que isso,
# nada é acrescentado.
AGENT_DURACAO_MS=30000

# Chave da Anthropic. Sem ela o agente cai num parecer de template e a demo segue rodando.
ANTHROPIC_API_KEY=

# Chaves usadas só pelo `yarn demo`. Em rede local, os padrões do Hardhat bastam.
GOVBR_ISSUER_PRIVATE_KEY=
DEMO_ARTISTA_PRIVATE_KEY=
DEMO_COLECIONADOR_PRIVATE_KEY=
DEMO_GALERIA_PRIVATE_KEY=
